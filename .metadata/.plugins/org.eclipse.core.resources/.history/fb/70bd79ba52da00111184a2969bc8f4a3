
package com.klef.soa.test;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;

import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.junit.jupiter.api.Assertions.assertTrue;

import java.util.List;
import java.util.Optional;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;

import com.klef.soa.entity.Clinic;
import com.klef.soa.repository.ClinicRepository;

@DataJpaTest
@AutoConfigureTestDatabase(replace = AutoConfigureTestDatabase.Replace.NONE)
public class ClinicRepositoryTest 
{
    @Autowired
    private ClinicRepository repository;

    @Test
    void testFindAllClinics() 
    {
        List<Clinic> clinics = repository.findAll();
      
        assertNotNull(clinics);
        assertFalse(clinics.isEmpty());
        System.out.println("Total Clinics: " + clinics.size());
    }

    @Test
    void testFindClinicById() 
    {
        Optional<Clinic> clinic = repository.findById(1L);
        assertTrue(clinic.isPresent());
        assertEquals(L, clinic.get().getClinicId());
        System.out.println("Clinic ID: " + clinic.get().getClinicId());
        System.out.println("Name: " + clinic.get().getName());
    }

    @Test
    void testFindClinicByName() 
    {
        List<Clinic> clinics = repository.findByName("Apollo");
        assertNotNull(clinics);
        assertFalse(clinics.isEmpty());
        System.out.println("Clinic Name: " + clinics);
    }

    @Test
    void testFindClinicByType() 
    {
        List<Clinic> clinics = repository.findByType("General");
        assertNotNull(clinics);
        assertFalse(clinics.isEmpty());
        System.out.println("Clinic Type: " + clinics);
    }

   

    @Test
    void testClinicDetails() 
    {
        Optional<Clinic> clinic = repository.findById(1L);
        assertTrue(clinic.isPresent());
        Clinic foundClinic = clinic.get();
        assertNotNull(foundClinic.getName());
        assertNotNull(foundClinic.getType());
        assertNotNull(foundClinic.getLocation());
        System.out.println("Name: " + foundClinic.getName());
        System.out.println("Type: " + foundClinic.getType());
        System.out.println("Location: " + foundClinic.getLocation());
    }
    @Test
    void testTotalClinicCount() 
    {
        long count = repository.count();
        assertEquals(2L, count);
    }
}
